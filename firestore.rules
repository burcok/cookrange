rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isParticipant(chatData) {
      return isAuthenticated() && request.auth.uid in chatData.participants;
    }

    function isPostOwner(postData) {
      return isAuthenticated() && request.auth.uid == postData.authorId;
    }

    // BLK-08: lets a non-owner adjust only engagement bookkeeping on a post —
    // like/reaction counters and their denormalized user-id lists — never
    // authorId/content/imageUrls/tags/groupId/metadata/etc. The two scalar
    // counters may only move by exactly one per write (no arbitrary count
    // injection); reactions/likedUserIds/recentLikers/reactionUserIds aren't
    // delta-checked (Firestore rules can't cheaply diff map/array magnitude)
    // — narrower than ideal, but a client can no longer touch any field
    // outside this list. `reactionUserIds` (Faz 0 audit fix): toggleReaction's
    // post-level write touches `reactionUserIds.$emoji` via dot-path update —
    // affectedKeys() reports the top-level `reactionUserIds` field, which was
    // missing from this allowlist, so a non-author's reaction was rejected.
    function canUpdatePostEngagement() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return isAuthenticated()
        && diff.hasOnly(['likesCount', 'likedUserIds', 'recentLikers', 'reactions', 'reactionUserIds', 'commentsCount'])
        && (!diff.hasAny(['likesCount'])
            || request.resource.data.likesCount == resource.data.likesCount + 1
            || request.resource.data.likesCount == resource.data.likesCount - 1)
        && (!diff.hasAny(['commentsCount'])
            || request.resource.data.commentsCount == resource.data.commentsCount + 1
            || request.resource.data.commentsCount == resource.data.commentsCount - 1);
    }

    // BLK-08: same idea for a comment — only its own like counter + per-emoji
    // reaction map, never authorId/content.
    function canUpdateCommentEngagement() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return isAuthenticated()
        && diff.hasOnly(['likesCount', 'reactions'])
        && (!diff.hasAny(['likesCount'])
            || request.resource.data.likesCount == resource.data.likesCount + 1
            || request.resource.data.likesCount == resource.data.likesCount - 1);
    }

    // BLK-08: gym post equivalent — snake_case field names, and the gym owner
    // (checked separately at the call site) already has unrestricted access,
    // so this only needs to cover the "any member" engagement path.
    function canUpdateGymPostEngagement() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return isAuthenticated()
        && diff.hasOnly(['like_count', 'liked_by_uids', 'comment_count'])
        && (!diff.hasAny(['like_count'])
            || request.resource.data.like_count == resource.data.like_count + 1
            || request.resource.data.like_count == resource.data.like_count - 1)
        && (!diff.hasAny(['comment_count'])
            || request.resource.data.comment_count == resource.data.comment_count + 1
            || request.resource.data.comment_count == resource.data.comment_count - 1);
    }

    function isSignalOwner(signalData) {
      return isAuthenticated() && request.auth.uid == signalData.userId;
    }

    // Faz 0 (audit fix): lets a non-owner bump a gym's `member_count` by
    // exactly ±1 (join/leave) — nothing else on the gym doc. Without this,
    // joinGym/leaveGym's `member_count` update was owner-only and the whole
    // batch (which also writes the member doc) failed for every non-owner.
    function canUpdateGymMemberCount() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return isAuthenticated()
        && diff.hasOnly(['member_count'])
        && (request.resource.data.member_count == resource.data.member_count + 1
            || request.resource.data.member_count == resource.data.member_count - 1);
    }

    // Faz 1 §1.4/1.5: live_occupancy is a server-maintained counter, written
    // only by the recordPresenceEvent Cloud Function's transaction (Admin
    // SDK, bypasses rules entirely). Without this, the gym owner's blanket
    // update rule below would let them set their own occupancy to anything —
    // exactly the kind of client-forgeable counter this session's audit
    // fixes (reputation_score, achievements) have been closing.
    // Faz 6 §6.5/§6.6: attributed_member_count (bumped by applyReferral's
    // gym-attribution branch) and attributed_premium_count (bumped by
    // maybeAwardGymCommission on a first premium conversion) are the exact
    // same shape of server-maintained counter — a client-writable version of
    // either would let a gym owner forge their own funnel numbers.
    function touchesProtectedGymFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['live_occupancy', 'attributed_member_count', 'attributed_premium_count']);
    }

    // Faz 2 §2.5: activity_score/activity_updated_at are computed only by
    // the computeGroupActivityScores scheduled function (functions/groups.js,
    // Admin SDK — bypasses rules entirely, so this never blocks the writer
    // that actually needs to write these fields). Mirrors
    // touchesProtectedGymFields()/touchesProtectedUserFields() exactly: a
    // client-writable activity score would be forgeable (a group owner
    // could just set it to a huge number to win the discovery carousel), so
    // it's excluded from the owner's otherwise-blanket update rule below —
    // same asymmetry as live_occupancy (isAdmin() is still exempt,
    // consistent with every other protected-field check in this file; site
    // admin already has unrestricted delete/update on this exact doc a few
    // lines down, so this isn't a new trust boundary).
    function touchesProtectedGroupFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['activity_score', 'activity_updated_at']);
    }

    // Faz 3 §3.2: usage_count ("N üyeye gönderildi") is bumped only by the
    // sendPlanOffer callable (functions/templates.js, Admin SDK — bypasses
    // rules entirely), never by the template's own author directly. Same
    // reasoning as touchesProtectedGymFields/touchesProtectedGroupFields: a
    // client-writable "times sent" counter would be forgeable social proof
    // in the template library UI (§3.3).
    function touchesProtectedTemplateFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['usage_count']);
    }

    // Same idea for community_groups — narrower than the pre-existing
    // hasOnly(...) check, which let a member set member_count to anything.
    function canUpdateGroupCounters() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return isAuthenticated()
        && diff.hasOnly(['member_count', 'last_activity_at', 'updated_at'])
        && (!diff.hasAny(['member_count'])
            || request.resource.data.member_count == resource.data.member_count + 1
            || request.resource.data.member_count == resource.data.member_count - 1);
    }

    // Faz 2 §2.3 — unified groups. Guarded with exists() first (mirrors this
    // file's isAdmin() convention) so a missing membership doc is a clean
    // "not a member" rather than a get()-on-missing-doc rule error.
    function isGroupMember(groupId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/community_groups/$(groupId)/members/$(request.auth.uid));
    }

    // Gym-scoped twin of isGroupMember() above — same existential-check
    // shape, deliberately NOT resource.data-dependent (it only reads the
    // CALLER's own membership doc, keyed off the fixed {gymId} path
    // segment), so it works for LIST queries too, not just single-doc
    // get()s. Faz 5 §5.3: added to fix a pre-existing gap the original
    // audit already named ("Liderlik tablosu (üye tarafı)... Sahip dışında
    // kimse göremiyor") but Faz 0 §0.1 never actually closed — `gyms/{id}/
    // members` read was owner-or-self only, so GymLeaderboardService's own
    // `.collection('members').limit(200).get()` (an unfiltered list query)
    // has been silently rejected for every non-owner member all along. This
    // is a genuine prerequisite for §5.3's in-gym XP leaderboard to work for
    // anyone but the gym owner, so it's fixed here rather than deferred.
    function isGymMember(gymId) {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.auth.uid));
    }

    // The caller's OWN role on [groupId], or 'none' if they have no
    // membership doc at all. Never used to authorize the TARGET of a write
    // (that's memberId/resource.data directly) — only the requester's own
    // standing.
    function groupMemberRole(groupId) {
      return isGroupMember(groupId)
        ? get(/databases/$(database)/documents/community_groups/$(groupId)/members/$(request.auth.uid)).data.get('role', 'member')
        : 'none';
    }

    // Banned members keep their doc (so they can never self-recreate it via
    // the open-join create path below) but lose all access — read, post,
    // react.
    function isActiveGroupMember(groupId) {
      return isGroupMember(groupId)
        && get(/databases/$(database)/documents/community_groups/$(groupId)/members/$(request.auth.uid)).data.get('banned', false) != true;
    }

    function isGroupOwner(groupId) {
      return get(/databases/$(database)/documents/community_groups/$(groupId)).data.owner_uid == request.auth.uid;
    }

    // Group-level 'admin' — day-to-day moderation (join requests, mute/
    // kick/ban, posting in announcement-only mode). Deliberately distinct
    // from isGroupOwner(): role CHANGES (who becomes admin/moderator) stay
    // owner/site-admin-only — see CommunityGroupService.setMemberRole's doc
    // comment for why promotion itself doesn't devolve to other admins.
    function isGroupAdminRole(groupId) {
      return groupMemberRole(groupId) == 'admin';
    }

    // request.time < request.time (the default when muted_until is absent)
    // is always false — "not muted" — without a separate null check.
    function isGroupMuted(groupId) {
      return isGroupMember(groupId)
        && request.time < get(/databases/$(database)/documents/community_groups/$(groupId)/members/$(request.auth.uid)).data.get('muted_until', request.time);
    }

    // Announcement-only gate for the group's message stream: any active,
    // unmuted member may post UNLESS announcement_only is on, in which case
    // only owner/admin may. Reading and reacting are NOT gated by this —
    // see the `messages/{messageId}` rule under community_groups below,
    // which only applies this to `create`.
    function canPostInGroup(groupId) {
      return isActiveGroupMember(groupId)
        && !isGroupMuted(groupId)
        && (get(/databases/$(database)/documents/community_groups/$(groupId)).data.get('announcement_only', false) != true
            || isGroupOwner(groupId)
            || isGroupAdminRole(groupId));
    }

    // A chat participant may update anything EXCEPT participants/type/
    // createdBy/unreadCounts — no adding/removing members, changing a
    // chat's kind, forging who created it, or free-writing unread counts
    // (Faz 2 §2.1 — see canMarkOwnUnreadZero() just below for the one
    // narrow carve-out). Message-level immutability is handled separately,
    // in the messages/{messageId} match block (Faz 2 §2.1).
    function canUpdateChatMeta() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return !diff.hasAny(['participants', 'type', 'createdBy', 'unreadCounts']);
    }

    // Faz 2 §2.1: unreadCounts INCREMENTS are exclusively server-side now
    // (onChatMessageCreated, functions/index.js, fans out to every
    // participant except the sender on each new message — see
    // markChatAsRead's old unbounded per-message batch, removed the same
    // pass). A participant may still self-declare "I've read everything up
    // to now" by zeroing ONLY their own key — never anyone else's key,
    // never a non-zero value, and never bundled with any other field in the
    // same write.
    function canMarkOwnUnreadZero() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return diff.hasOnly(['unreadCounts'])
        && request.resource.data.unreadCounts[request.auth.uid] == 0
        && request.resource.data.unreadCounts.diff(resource.data.unreadCounts)
             .affectedKeys().hasOnly([request.auth.uid]);
    }

    // Faz 2 §2.1 — message v2 schema. Mirrors the checkins `timestamp ==
    // request.time` idiom (below, gyms/{id}/checkins): requires the client
    // send a serverTimestamp() sentinel, not a spoofable client clock value.
    // `timestamp` is a deliberate, temporary compatibility mirror of the
    // same instant (DATABASE.md §10 "adding a field") so the existing
    // orderBy('timestamp') message stream keeps surfacing new docs
    // alongside pre-migration ones without a backfill — see
    // ChatService.sendMessage. The field list is intentionally exhaustive
    // (hasNoExtraFields): a brand-new message can't arrive pre-populated
    // with reactions/read receipts/edits it hasn't earned yet.
    function isValidNewMessage() {
      let d = request.resource.data;
      return d.senderId == request.auth.uid
        && d.server_timestamp == request.time
        && d.timestamp == request.time
        && d.type in ['text', 'image', 'system', 'plan_offer', 'announcement']
        && d.get('body', '').size() <= 5000
        && d.get('attachments', []).size() <= 10
        && d.get('mentions', []).size() <= 50
        && d.get('read_by', []).size() == 0
        && d.get('delivered_to', []).size() == 0
        && d.get('reactions', {}).size() == 0
        && hasNoExtraFields(['id', 'senderId', 'type', 'body', 'attachments',
             'reply_to', 'forwarded_from', 'reactions', 'delivered_to',
             'read_by', 'mentions', 'server_timestamp', 'client_id',
             'timestamp']);
    }

    // Sender-only content edit, 15-minute window from server_timestamp. The
    // plan groups body/edited_at/is_deleted/deleted_for's 'everyone' form
    // under this ONE window — "delete for everyone" is not a separate,
    // longer grace period. A pre-migration message has no server_timestamp
    // at all and is therefore never editable through this path — it
    // predates the window concept entirely; deny rather than guess an
    // origin time.
    function canEditOwnMessage() {
      let existing = resource.data;
      let hasServerTs = existing.get('server_timestamp', null) != null;
      let diff = request.resource.data.diff(existing).affectedKeys();
      return existing.senderId == request.auth.uid
        && hasServerTs
        && request.time < existing.server_timestamp + duration.value(15, 'm')
        && diff.hasOnly(['body', 'edited_at', 'is_deleted', 'deleted_for']);
    }

    // Any participant may append a read/delivery receipt, toggle a
    // reaction, or add themselves to a "delete for me" list — never touch
    // content, sender, or (via the `is list` guard) the sender-only
    // 'everyone' deletion string reserved for canEditOwnMessage(). Element-
    // level "only your own uid was added" scoping isn't cheaply expressible
    // in rules — same bar canUpdatePostEngagement/signals.ignoredBy already
    // accept elsewhere in this file for the identical class of denormalized
    // uid-list field.
    function canUpdateMessageEngagement() {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return diff.hasOnly(['read_by', 'delivered_to', 'reactions', 'deleted_for'])
        && (!diff.hasAny(['deleted_for']) || request.resource.data.deleted_for is list);
    }

    // Faz 2 §2.6 — a group owner/admin (or site admin) may take down ANOTHER
    // member's message. Deliberately narrower than canEditOwnMessage(): only
    // is_deleted/deleted_for may move, never body/edited_at — a moderator
    // removes visibility, they don't get to rewrite or impersonate what the
    // sender said. No 15-minute window either: unlike the sender's own edit
    // grace period, moderation can act on an old message same as a new one.
    // isGroupOwner/isGroupAdminRole/isAdmin are this file's existing
    // membership checks (used identically for mute/kick/ban below) — this
    // just extends the same authority to one more surface, the message
    // itself, rather than only the member doc.
    function canModeratorDeleteMessage(groupId) {
      let diff = request.resource.data.diff(resource.data).affectedKeys();
      return diff.hasOnly(['is_deleted', 'deleted_for'])
        && request.resource.data.is_deleted == true
        && request.resource.data.deleted_for == 'everyone'
        && (isGroupOwner(groupId) || isGroupAdminRole(groupId) || isAdmin());
    }

    function isAdmin() {
      // Admin-ness lives in a dead-simple top-level doc: `admin_roles/{uid}` with
      // `is_admin: true`. Trivial to create in the console (one collection, one
      // doc, one field) and client-unwritable (catch-all deny → server/console
      // only), so it can't be self-granted. exists()-guarded so a missing doc is
      // a clean false. (Ban flags stay separately at admin/status/{uid}/flags.)
      return isAuthenticated()
        && exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_roles/$(request.auth.uid)).data.is_admin == true;
    }

    // Faz 2 §2.6 — reactive abuse-rate throttle for reports, group
    // moderation actions (mute/kick/ban/unmute/unban), and moderation
    // appeals. `rate_limits/{uid}` is a fully server-only ledger (no client
    // read/write rule at all, see that collection's block below) —
    // `functions/rate_limit.js` bumps a sliding-window counter on every
    // create of the corresponding collection (mirrors index.js's
    // `enforceRateLimitAndQuota` RATE_WINDOW_MS/RATE_MAX_IN_WINDOW shape,
    // generalized) and, once a uid crosses the threshold, stamps a
    // `*_locked_until` timestamp here that these three checks enforce on
    // every SUBSEQUENT write. A client can never clear its own lock. The
    // `.get(..., request.time)` default mirrors isGroupMuted()'s idiom just
    // above: "request.time < request.time" is always false when the field
    // (or the whole doc) is absent, i.e. "not limited" by default.
    function isReportRateLimited() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/rate_limits/$(request.auth.uid))
        && request.time < get(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.get('report_locked_until', request.time);
    }
    function isModerationRateLimited() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/rate_limits/$(request.auth.uid))
        && request.time < get(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.get('moderation_locked_until', request.time);
    }
    function isAppealRateLimited() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/rate_limits/$(request.auth.uid))
        && request.time < get(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.get('appeal_locked_until', request.time);
    }

    // SEC-12 — same pattern, six new kinds (functions/ugc_rate_limit.js).
    // 'post'/'comment'/'reaction' budgets are each shared across more than
    // one collection (top-level + gym-scoped posts/comments; reactions +
    // likes + comment-likes) — one spam budget per user per ACTION KIND,
    // not one per collection path.
    function isPostRateLimited() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/rate_limits/$(request.auth.uid))
        && request.time < get(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.get('post_locked_until', request.time);
    }
    function isCommentRateLimited() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/rate_limits/$(request.auth.uid))
        && request.time < get(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.get('comment_locked_until', request.time);
    }
    function isMessageRateLimited() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/rate_limits/$(request.auth.uid))
        && request.time < get(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.get('message_locked_until', request.time);
    }
    function isGroupCreateRateLimited() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/rate_limits/$(request.auth.uid))
        && request.time < get(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.get('group_create_locked_until', request.time);
    }
    function isFollowRateLimited() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/rate_limits/$(request.auth.uid))
        && request.time < get(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.get('follow_locked_until', request.time);
    }
    function isReactionRateLimited() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/rate_limits/$(request.auth.uid))
        && request.time < get(/databases/$(database)/documents/rate_limits/$(request.auth.uid)).data.get('reaction_locked_until', request.time);
    }

    // Validate that only allowed fields are being written
    function hasNoExtraFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }

    // Fields on the user doc that are SERVER-AUTHORITATIVE — clients may never
    // write them. Entitlements, AI credits, ban state, and the referral marker
    // are set ONLY by Cloud Functions (Admin SDK, which bypasses rules) or by an
    // admin. This closes premium / AI-credit self-grant and ban-evasion via
    // direct user-doc writes (audit C1, C2, C3, C7).
    //
    // NOTE: user_roles/user_role are intentionally NOT locked here. The app's
    // self-service model lets a user become coach/gymOwner (coach_service /
    // gym_service write their own roles), and coach/gym FEATURES are gated by
    // ownership, not by this array. True admin power is gated server-side by
    // admin_roles/{uid} (write: false — console/Admin-SDK only, see isAdmin()
    // above) — a self-written user_roles: ['admin'] only reveals client admin
    // UI, never real admin capability. The client now gates that UI on the
    // `admin` custom claim that syncAdminClaim mirrors from admin_roles/{uid}
    // (BLK-05), not on this array. (admin/status/{uid}/flags is a separate,
    // unrelated concept — ban state, not admin-ness.)
    //
    // SEC-29 cross-reference: this function's `diff()` only ever runs on
    // `update` (resource.data doesn't exist pre-create) — it does NOT
    // protect `create` at all. `users/{uid}`'s `allow create` block below
    // has its OWN, separate forbid-list covering the same fields (minus
    // streak_freeze_count, which create bounds instead of forbidding — see
    // that rule's comment for why). If you add a new server-authoritative
    // field to THIS list, also consider whether the create-time forbid-list
    // needs it, and vice versa — the two are intentionally parallel but not
    // mechanically shared.
    function touchesProtectedUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'subscription_tier', 'subscription_expires_at', 'subscription_product_id',
        'subscription_purchase_token', 'ai_credits_used', 'ai_credits_reset_at',
        'ai_credits_bonus', 'referral_used', 'is_banned',
        // Faz 0 §0.4: reputation is now computed + written only by the
        // syncProgress Cloud Function (functions/progress.js) — previously
        // client-writable, so any user could set their own reputation_score
        // directly (ReputationService._cacheScore, before this fix).
        'reputation_score', 'reputation_updated_at',
        // Faz 5 §5.1: XP/level are server-write-only from the very first
        // write (never client-writable at all, unlike reputation_score
        // which had to be closed retroactively) — `awardXp`
        // (functions/progress.js) is the only writer, gated by the
        // xp_events ledger below. A client self-writing these directly
        // would bypass every per-action point value and daily cap.
        'xp', 'level', 'level_updated_at',
        // Faz 5 §5.3: consecutive-week group-contribution streak counter —
        // gates the `groupStreak4` badge exactly like every other reward-
        // gating counter in this list. Written only by
        // `bumpGroupTop3Streak` (functions/engagement_credit.js).
        'group_top3_streak', 'group_top3_streak_week_key',
        // SEC-14: streak-freeze count is a reward-gating counter exactly
        // like the others above — server-write-only via the
        // `processStreakLogin` Cloud Function (functions/progress.js).
        // `onboarding_data.streak` is the other half of this fix but can't
        // be a bare entry in this list (see `onboardingStreakChanged()`
        // below): `onboarding_data` also holds the client-writable
        // `meal_reminder`/`water_reminder` settings, and `affectedKeys()`
        // only sees the top-level `onboarding_data` key, so a blanket entry
        // here would wrongly block those too.
        'streak_freeze_count',
        // SEC-31: SEC-14 locked streak_freeze_count/onboarding_data.streak
        // themselves but missed the one input processStreakLogin actually
        // reads to decide which branch to take — `last_login_at`. Before
        // this, a client could call the raw SDK directly (not just the
        // app's own FieldValue.serverTimestamp() convention — nothing at
        // the rules level enforced that over a fabricated literal
        // Timestamp) to set last_login_at to an arbitrary past value, then
        // call processStreakLogin repeatedly to farm streak increments or
        // drain/refill streak_freeze_count on demand — defeating SEC-14 one
        // hop removed from the fields it actually locked. last_login_at is
        // legitimately written server-side by processStreakLogin's own
        // transaction (functions/progress.js) whenever it has a prior value
        // to diff against; the client's own former write of the same field
        // (firestore_service.dart's handleUserLogin, existing-user branch)
        // was already redundant by the time it ran and has been removed
        // there. streak_freeze_used_at is the companion timestamp
        // processStreakLogin sets alongside a freeze consumption — same
        // server-write-only shape, and no client code writes it (the
        // client-side freeze logic that used to was deleted by the
        // original SEC-14 fix — confirmed by grep, zero remaining writers).
        'last_login_at', 'streak_freeze_used_at'
      ]) || onboardingStreakChanged();
    }

    // SEC-14: `onboarding_data.streak` is server-write-only (written only by
    // `processStreakLogin`, functions/progress.js) even though its parent map
    // `onboarding_data` is otherwise client-writable (meal_reminder/
    // water_reminder). Since affectedKeys() can't see inside the map, this
    // diffs the nested value directly instead.
    //
    // SEC-32 (companion to SEC-30, same bug class, this function's `update`-
    // side instead of that rule's `create`-side): a bare `.get(key, default)`
    // — the idiom this function used originally — only substitutes the
    // default for a MISSING key, not one present with value `null`. If
    // `onboarding_data` is explicitly `null` on either side of the diff,
    // `.get('onboarding_data', {})` evaluates to `null` itself (not `{}`),
    // and the chained `.get('streak', null)` on that `null` raises a
    // Firestore Rules runtime "Null value error" — an ERRORING condition
    // denies the whole `update`. Not reachable by any current `lib/` write
    // path (grepped, same as SEC-30) — defense-in-depth, not a live bug.
    // Fixed with the same explicit `is map` guard SEC-30 uses on `create`,
    // applied on both sides since this function diffs two snapshots. Once
    // guarded, a real streak value going to `null`/non-map is DENIED (not
    // specially allowed through) — consistent with this function already
    // treating any change to the effective streak value, including it
    // disappearing entirely, as "changed" (see `test/firestore_rules/
    // rules.test.mjs`'s SEC-32 block for the full reasoning, including why
    // a more permissive variant would reopen a two-step forgery).
    function onboardingStreakChanged() {
      let oldStreak = resource.data.get('onboarding_data', {}) is map
        ? resource.data.get('onboarding_data', {}).get('streak', null) : null;
      let newStreak = request.resource.data.get('onboarding_data', {}) is map
        ? request.resource.data.get('onboarding_data', {}).get('streak', null) : null;
      return oldStreak != newStreak;
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      // Users can read any profile (needed for search, friend lists, chat presence)
      allow read: if isAuthenticated();
      // Only the owner can create/update their own document.
      // SEC-14: a brand-new doc must never start with more than the
      // legitimate welcome-gift values. Bounded to <= 1 rather than "must
      // equal exactly 1" because two different client doc-creation paths
      // exist (firestore_service.dart): `handleUserLogin`'s new-user branch
      // explicitly sets streak_freeze_count: 1 / onboarding_data.streak: 1,
      // while `createUserDocumentOnRegister` omits streak_freeze_count
      // entirely and passes through a caller-supplied onboarding_data map.
      // This tolerates both legitimate shapes without auditing every caller,
      // while still mechanically blocking any large/attacker-supplied value.
      allow create: if isOwner(uid)
        && (!('streak_freeze_count' in request.resource.data)
            || (request.resource.data.streak_freeze_count is int
                && request.resource.data.streak_freeze_count >= 0
                && request.resource.data.streak_freeze_count <= 1))
        // SEC-30: `onboarding_data` can legitimately be an explicit `null` —
        // `createUserDocumentOnRegister` (firestore_service.dart) passes
        // through whatever `getOnboardingData()` returns, which is `null`
        // on a SharedPreferences cache miss or parse failure (both real,
        // reachable paths — not contrived). The KEY is still present when
        // that happens, so `!('onboarding_data' in request.resource.data)`
        // alone does not short-circuit, and `'streak' in null` then raises a
        // Firestore Rules runtime "Null value error" — an ERRORING condition
        // denies the whole `create`, so a legitimate registration was
        // rejected outright (not merely left unbounded). Confirmed
        // empirically that reusing `onboardingStreakChanged()`'s
        // `.get(key, default)` idiom verbatim does NOT fix this: `.get`
        // substitutes the default only for a MISSING key, not a key present
        // with value `null` — `request.resource.data.get('onboarding_data',
        // {})` still evaluates to `null` here, and `.get('streak', ...)` on
        // that `null` still throws the identical error. The explicit
        // `is map` check below is the part that actually short-circuits
        // before ever indexing into `null`.
        && (!('onboarding_data' in request.resource.data)
            || !(request.resource.data.onboarding_data is map)
            || !('streak' in request.resource.data.onboarding_data)
            || (request.resource.data.onboarding_data.streak is int
                && request.resource.data.onboarding_data.streak >= 0
                && request.resource.data.onboarding_data.streak <= 1))
        // SEC-29: the two bounds above (SEC-14) were the ONLY create-time
        // constraints that existed until now. Every OTHER field
        // touchesProtectedUserFields() locks against `update` (xp/level,
        // reputation, the whole subscription/ai_credits entitlement group,
        // referral_used, is_banned, the group streak pair) was completely
        // unconstrained on `create` — that function's diff() only runs on
        // `update`, never `create`. A technical user could bypass the app
        // and call the Firestore client SDK directly to CREATE their own
        // users/{uid} doc with e.g. `xp: 999999`,
        // `subscription_tier: 'premium'`, or `ai_credits_bonus: 999999`
        // already baked in.
        //
        // Verified (grep across lib/): no legitimate client doc-creation
        // path — handleUserLogin's new-user branch,
        // createUserDocumentOnRegister, or
        // notification_preferences_service.dart's mute-preference writes —
        // ever sets any of these fields at creation time. Since there is
        // zero legitimate reason for a client to ever set them at create,
        // forbidding their presence outright is strictly safer than trying
        // to bound each one (the way streak_freeze_count/
        // onboarding_data.streak are handled above) and cannot break any
        // real flow.
        //
        // Kept as a literal list rather than reusing
        // touchesProtectedUserFields()'s list directly: that list ALSO
        // contains streak_freeze_count, which needs different treatment
        // here (creatable at a bounded value for the welcome gift, not
        // forbidden outright) — a shared abstraction wouldn't cleanly fit
        // both cases. See touchesProtectedUserFields()'s own comment for
        // the reverse cross-reference.
        && !request.resource.data.keys().hasAny([
             'xp', 'level', 'level_updated_at',
             'reputation_score', 'reputation_updated_at',
             'subscription_tier', 'subscription_expires_at', 'subscription_product_id', 'subscription_purchase_token',
             'ai_credits_used', 'ai_credits_reset_at', 'ai_credits_bonus',
             'referral_used', 'is_banned',
             'group_top3_streak', 'group_top3_streak_week_key'
           ]);
      // Owner may update only NON-privileged fields; privileged fields
      // (entitlements/credits/roles/ban/referral) are server/admin-written and
      // rejected here for clients. Admin (server) retains full update.
      allow update: if (isOwner(uid) && !touchesProtectedUserFields())
        || isAdmin();
      allow delete: if isOwner(uid);

      // Friends subcollection (BLK-03/SEC-06): owner reads; mutation is
      // server-only (functions/social.js: sendFriendRequest,
      // respondToFriendRequest) — a bare isAuthenticated() create let any
      // signed-in user write into anyone's friends list. Delete stays
      // client-side (removeFriend) — it only ever affects the caller's own
      // subtree, so no forgery is possible there.
      match /friends/{friendId} {
        allow read: if isOwner(uid);
        allow create, update: if false;
        allow delete: if isOwner(uid);
      }

      // Friend requests subcollection (BLK-03/SEC-06): fully server-authored.
      // functions/social.js validates, writes both sides, and cleans up on
      // accept/reject/cancel — no legitimate client write path remains.
      match /friend_requests/{requestId} {
        allow read: if isOwner(uid);
        allow create, update, delete: if false;
      }

      // Notifications (BLK-03/SEC-06): this old path (users/{uid}/notifications)
      // is retired — the canonical path is the top-level
      // notifications/{uid}/items/{docId} rule below, matching the Cloud
      // Function trigger that fans out push. No data migration was needed:
      // v0.9.6 has no real users yet (PROJECT_STATE.md). Falls through to the
      // catch-all deny.

      // Meal plans: strictly owner-only
      match /meal_plans/{planId} {
        allow read, write: if isOwner(uid);
      }

      // Archived weekly meal plans (history): strictly owner-only
      match /meal_plan_history/{historyId} {
        allow read, write: if isOwner(uid);
      }

      // Faz 3 §3.2: a meal_plan_templates/{id} sent to this user by a
      // gym/coach/admin. create is SERVER-ONLY (sendPlanOffer callable,
      // functions/templates.js) — it validates the sender's authority over
      // the template and the recipient's real standing (gym membership /
      // active coaching relationship) before writing, and takes the
      // immutable template_snapshot copy, so from_uid/from_type/the
      // snapshot itself can never be forged and an offer can't be planted
      // on someone who was never actually offered anything (not even by
      // themselves). The recipient may only move status/responded_at —
      // accept or decline, exactly once, never re-open a resolved offer,
      // never rewrite who it's from or what it references. No delete: like
      // `checkins`/`food_logs`, a resolved offer is a durable record, not
      // an inbox item to be tidied away.
      //
      // Faz 3 §3.5: `decline_reason` (optional free text, ≤300 chars) may
      // ALSO change, but only alongside a decline — "gerekçe opsiyonel"
      // (the plan's own wording): a client can never attach a reason to an
      // accept, and can never write a reason with no status change.
      // `functions/templates.js`'s `onPlanOfferResponded` trigger reads it
      // to forward the reason into the sender's quiet notification.
      match /plan_offers/{offerId} {
        allow read: if isOwner(uid);
        allow create: if false;
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'responded_at', 'decline_reason'])
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted', 'declined']
          && request.resource.data.responded_at == request.time
          && request.resource.data.get('decline_reason', '') is string
          && request.resource.data.get('decline_reason', '').size() <= 300
          && (request.resource.data.get('decline_reason', '') == '' || request.resource.data.status == 'declined');
        allow delete: if false;
      }

      // Food logs: create + read only. Same immutability pattern as
      // `checkins` (S6) — a logged meal is a historical record that backs
      // streaks, the leaderboard, and achievements; letting it be edited or
      // deleted after the fact let those be gamed. `removeLog`
      // (food_log_service.dart) is dead code (0 UI call sites) so this
      // closes a real hole without touching a live feature.
      match /food_logs/{logId} {
        allow read, create: if isOwner(uid);
        allow update, delete: if false;
      }

      // Favorites (bookmarked recipes): strictly owner-only
      match /favorites/{recipeId} {
        allow read, write: if isOwner(uid);
      }

      // Shopping list
      match /lists/{listId} {
        allow read, write: if isOwner(uid);
      }

      // Recent foods for quick-add
      match /recent_foods/{foodId} {
        allow read, write: if isOwner(uid);
      }

      // AI food-analysis history: strictly owner-only
      match /food_analyses/{analysisId} {
        allow read, write: if isOwner(uid);
      }

      // Saved/bookmarked community posts
      match /saved_posts/{postId} {
        allow read, write: if isOwner(uid);
      }

      // Notification preferences
      match /notification_preferences/{prefId} {
        allow read, write: if isOwner(uid);
      }

      // Exercise / activity logs
      match /exercise_logs/{logId} {
        allow read, write: if isOwner(uid);
      }

      // Personal recipe notes
      match /recipe_notes/{recipeId} {
        allow read, write: if isOwner(uid);
      }

      // Private PII subcollection (nutrition profile) — owner-only; never
      // readable by other authenticated users regardless of friendship status.
      match /private/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Private account subcollection (audit N1): email, login/device/
      // session history, current app version, FCM token — previously on the
      // world-readable main doc (firestore.rules read rule above is
      // document-level and can't hide individual fields; the only real fix
      // is not storing them there). Admin may additionally READ (support:
      // email lookup, password reset) but never write — an admin has no
      // legitimate reason to forge someone's login history or push token.
      // This is additive to the wildcard /private/{docId} rule above (both
      // apply; Firestore rules are a union of every matching block), so
      // /private/nutrition stays exactly as strict as before.
      match /private/account {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid);
      }
    }

    // ─── Logs (auth/session/activity audit trail) ───────────────────────────
    match /logs/{userId} {
      // Only the owner can read; auth service can write (uses server-side patterns)
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // ─── Failed login attempts (security monitoring) ────────────────────────
    match /failed_login_attempts/{docId} {
      // Server-only: an UNAUTHENTICATED `create: if true` let anyone spam this
      // collection (write-amplification / billing abuse, audit C7). Failed-login
      // monitoring must come from Identity Platform / an Auth blocking function,
      // not unauthenticated client writes. The client writer is best-effort and
      // tolerates this denial.
      allow create, read, update, delete: if false;
    }

    // ─── Dishes (read-only catalog for users) ───────────────────────────────
    match /dishes/{dishId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isAdmin();
    }

    // ─── App Settings (public-read config; admin-managed) ────────────────────
    // e.g. settings/content_filter holds the moderation word-list, mirrored here
    // from admin_config so the client filter (all users) can read it.
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Community Posts ─────────────────────────────────────────────────────
    match /posts/{postId} {
      allow read: if isAuthenticated();
      // SEC-07 fix: this collection's optional `groupId` field (per
      // community_service.dart's own comment, "enables group-scoped
      // feeds") had NO group-membership check at all — unlike the parallel
      // group-chat message path (canPostInGroup), which correctly enforces
      // ban/mute/announcement-only. A banned/muted/never-joined user could
      // post into ANY group's feed (including a kind:'gym' group) just by
      // setting groupId on the payload. Mirrors canPostInGroup exactly when
      // groupId is present; posts with no groupId (personal/public feed)
      // are unaffected. SEC-12: rate-limited (shared 'post' budget with the
      // gym-scoped posts rule below).
      allow create: if isAuthenticated()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.get('content', '').size() <= 5000
        && (request.resource.data.get('groupId', null) == null
            || canPostInGroup(request.resource.data.groupId))
        && !isPostRateLimited();
      // BLK-08: update was a denylist (only authorId/content/imageUrls/tags
      // blocked) so any authenticated user could write ANY other field —
      // groupId, is_announcement-style flags, metadata, timestamp, etc.
      // Now an allowlist: non-owners may only adjust engagement bookkeeping,
      // and the two scalar counters may only move by exactly one per write.
      allow update: if isAuthenticated()
        && (isPostOwner(resource.data) || canUpdatePostEngagement());
      allow delete: if isAuthenticated() && isPostOwner(resource.data);

      // Comments
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        // SEC-07/SEC-12: if the parent post is group-scoped, the same
        // membership bar as posting applies to commenting — a banned/
        // muted/never-joined user has no legitimate standing to comment
        // either. Rate-limited (shared 'comment' budget with the gym-scoped
        // comments rule below).
        allow create: if isAuthenticated()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.get('content', '').size() <= 2000
          && (get(/databases/$(database)/documents/posts/$(postId)).data.get('groupId', null) == null
              || canPostInGroup(get(/databases/$(database)/documents/posts/$(postId)).data.groupId))
          && !isCommentRateLimited();
        // BLK-08: same denylist bug as the post-level rule above.
        allow update: if isAuthenticated()
          && (resource.data.authorId == request.auth.uid
            || canUpdateCommentEngagement());
        allow delete: if isAuthenticated()
          && resource.data.authorId == request.auth.uid;

        // Comment likes. SEC-12: create is rate-limited (shared 'reaction'
        // budget with post likes/reactions below); un-liking is not.
        match /likes/{userId} {
          allow read: if isAuthenticated();
          allow create: if isOwner(userId) && !isReactionRateLimited();
          allow update, delete: if isOwner(userId);
        }

        // Faz 5 §5.2 — fully server-only bookkeeping: the cached content-
        // quality/duplicate-content verdict for THIS comment plus the
        // running weighted progress toward the comment-likes credit
        // threshold. Nobody (not even the comment's own author) reads or
        // writes this directly — `engagement_credit_events` is the
        // user-facing audit trail, this is internal working state.
        match /credit_progress/{docId} {
          allow read, write: if false;
        }
      }

      // Post likes. SEC-12: create is rate-limited (shared 'reaction'
      // budget with post reactions and comment likes); un-liking is not.
      match /likes/{userId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId) && !isReactionRateLimited();
        allow update, delete: if isOwner(userId);
      }

      // Post reactions. SEC-12: same shared 'reaction' budget.
      match /reactions/{userId} {
        allow read: if isAuthenticated();
        allow create: if isOwner(userId) && !isReactionRateLimited();
        allow update, delete: if isOwner(userId);
      }

      // Faz 5 §5.2 — post-level equivalent of the comment credit_progress
      // doc above (post-reactions credit source AND the weekly-group-
      // contribution triggers share this same cache for a group-scoped
      // post's content-eligibility verdict).
      match /credit_progress/{docId} {
        allow read, write: if false;
      }
    }

    // ─── Chats ────────────────────────────────────────────────────────────────
    // Faz 2 §2.3: a group-backed chat (`groupId` set — created alongside a
    // community_groups doc, `chat_id` there points back here) is accessible
    // to the whole group's membership, NOT just whoever is in `participants`
    // (which only ever holds the group's owner — see
    // CommunityGroupService.createGroup's doc comment on why maintaining a
    // full member-list array here doesn't scale). `isGroupBackedChat()`
    // reads `false` (via the `!= null` default) for every pre-Faz-2.3 chat,
    // so this is additive — no existing DM/ad-hoc-group chat's behavior
    // changes.
    function isGroupBackedChat(chatData) {
      return chatData.get('groupId', null) != null;
    }
    function canAccessGroupChat(chatData) {
      return isGroupBackedChat(chatData) && isActiveGroupMember(chatData.groupId);
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated()
        && (isParticipant(resource.data) || canAccessGroupChat(resource.data));
      // isAdmin() lets AdminService.approveGymApplication batch-create the
      // GYM OWNER's paired chat (participants: [gym owner uid], but the
      // batch runs under the APPROVING ADMIN's auth context) — same
      // reasoning as the community_groups create rule's admin branch just
      // above.
      allow create: if isAuthenticated()
        && (request.auth.uid in request.resource.data.participants || isAdmin());
      allow update: if isAuthenticated()
        && (isParticipant(resource.data) || canAccessGroupChat(resource.data))
        && (canUpdateChatMeta() || canMarkOwnUnreadZero());
      allow delete: if false; // Chats are never deleted client-side

      // Faz 2 §2.1 — message v2. Create requires the full shape
      // (isValidNewMessage); update is split between the sender's own
      // 15-minute content-edit window (canEditOwnMessage) and any
      // participant's engagement touches — reactions/read receipts/
      // delivery receipts/"delete for me" (canUpdateMessageEngagement).
      // Before this, ANY participant could rewrite ANY field of ANYONE
      // else's message — this closes that (Faz 0 audit gap, see
      // canUpdateChatMeta's old comment).
      //
      // Faz 2 §2.3: a group-backed chat's create additionally honors
      // announcement_only (canPostInGroup) — everyone else may still read
      // and react (canUpdateMessageEngagement is unaffected by
      // announcement_only, matching "diğerleri okur + tepki verir").
      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && (isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
              || canAccessGroupChat(get(/databases/$(database)/documents/chats/$(chatId)).data));
        // SEC-12: rate-limited (functions/ugc_rate_limit.js).
        allow create: if isAuthenticated()
          && isValidNewMessage()
          && (isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
              || (isGroupBackedChat(get(/databases/$(database)/documents/chats/$(chatId)).data)
                  && canPostInGroup(get(/databases/$(database)/documents/chats/$(chatId)).data.groupId)))
          && !isMessageRateLimited();
        // Faz 2 §2.6: a group-backed chat's update additionally accepts a
        // moderator takedown of someone ELSE's message
        // (canModeratorDeleteMessage) — the only one of the three update
        // paths that doesn't require the caller to be the sender.
        allow update: if isAuthenticated()
          && (isParticipant(get(/databases/$(database)/documents/chats/$(chatId)).data)
              || canAccessGroupChat(get(/databases/$(database)/documents/chats/$(chatId)).data))
          && (canEditOwnMessage()
              || canUpdateMessageEngagement()
              || (isGroupBackedChat(get(/databases/$(database)/documents/chats/$(chatId)).data)
                  && canModeratorDeleteMessage(get(/databases/$(database)/documents/chats/$(chatId)).data.groupId)));
        allow delete: if false;
      }
    }

    // ─── Signals (ephemeral social broadcasts) ────────────────────────────────
    match /signals/{signalId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('message', '').size() <= 2000;
      allow update: if isAuthenticated()
        && (isSignalOwner(resource.data)
          // Allow others to add themselves to ignoredBy list
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ignoredBy']));
      allow delete: if isAuthenticated() && isSignalOwner(resource.data);
    }

    // ─── Reports (write-only for authenticated users; read restricted to admin) ─
    match /reports/{reportId} {
      // Faz 2 §2.6: !isReportRateLimited() blunts mass-reporting brigades —
      // see that function's doc comment for the reactive-trigger design and
      // its honest bounded-lag limitation.
      allow create: if isAuthenticated()
        && request.resource.data.reporterId == request.auth.uid
        && !isReportRateLimited();
      // Admins read the moderation queue + action reports (dismiss/remove).
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── Privacy / data-subject requests (DSAR — KVKK/GDPR) ───────────────────
    // Owner files + reads own; admin reads + updates (status/notes). No deletion.
    match /privacy_requests/{requestId} {
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── Moderation appeals (Faz 2 §2.6) ──────────────────────────────────────
    // Mirrors privacy_requests' shape exactly (client creates its own record,
    // admin reviews/resolves later — no callable, same as DSAR). Doc id ==
    // the SOURCE community_groups/{group_id}/moderation/{autoId} entry's own
    // id — guarantees at most one appeal per action (a second attempt by the
    // same uid is a Firestore `update`, not `create`, and update is
    // admin-only below) and lets the create rule cross-check, via get(),
    // that appealId really does name a real moderation action whose
    // target_uid is the caller — a client can't fabricate an appeal against
    // an action that isn't theirs or doesn't exist.
    // Faz 5 §5.2 addition: a SECOND appeal kind, `action == 'credit_restriction'`
    // — reuses this exact collection/lifecycle/rate-limiter rather than a
    // second appeals system, per that task's explicit instruction. Doc id
    // still IS the source log entry's own id, but the source now lives at
    // `users/{callerUid}/credit_moderation/{appealId}` instead of a group's
    // moderation log — since that path is already scoped to the CALLER's own
    // uid (unlike a group id, which is caller-supplied and arbitrary), no
    // separate `target_uid` cross-check field is needed: if the get()
    // resolves at all, it's necessarily an entry about the caller's own
    // account, and `action == 'restrict'` confirms it's the appealable kind
    // (a `lift` entry — restriction already lifted — has nothing to appeal).
    match /moderation_appeals/{appealId} {
      allow read: if isAuthenticated()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.get('message', '').size() <= 2000
        && !isAppealRateLimited()
        && ((request.resource.data.action in ['mute', 'kick', 'ban']
              && get(/databases/$(database)/documents/community_groups/$(request.resource.data.group_id)/moderation/$(appealId)).data.target_uid == request.auth.uid)
            || (request.resource.data.action == 'credit_restriction'
              && get(/databases/$(database)/documents/users/$(request.auth.uid)/credit_moderation/$(appealId)).data.action == 'restrict'));
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ─── Rate-limit ledger (Faz 2 §2.6) ───────────────────────────────────────
    // Fully server-only — functions/rate_limit.js (Admin SDK, bypasses this
    // entirely) is the only writer; isReportRateLimited()/
    // isModerationRateLimited()/isAppealRateLimited() above are the only
    // readers, both via get(), never a direct client read. Mirrors
    // presence_notify_log/processed_purchases: internal bookkeeping nobody
    // reads back through the client SDK.
    match /rate_limits/{uid} {
      allow read, write: if false;
    }

    // ─── Block list (per-user, full CRUD by owner only) ──────────────────────
    match /users/{uid}/block_list/{blockedId} {
      allow read, write: if isOwner(uid);
    }

    // ─── Starred messages (Faz 2 §2.2 — per-user chat bookmark) ──────────────
    // Doc id = messageId (idempotent star/unstar). Mirrors block_list exactly:
    // a personal list nobody else needs to read or write.
    match /users/{uid}/starred_messages/{messageId} {
      allow read, write: if isOwner(uid);
    }

    // ─── Challenges ──────────────────────────────────────────────────────────
    match /challenges/{challengeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid;
      // Only creator can update title/desc/goal; any participant can update progress field
      allow update: if isAuthenticated()
        && (resource.data.createdBy == request.auth.uid
            || request.auth.uid in resource.data.participantIds);
      allow delete: if isAuthenticated()
        && resource.data.createdBy == request.auth.uid;
    }

    // ─── Referral codes ───────────────────────────────────────────────────────
    // Faz 6 §6.1: `type` gained a third value, 'gym' — a code a gym owner
    // generates for a printed poster/social share (user ACQUISITION). Distinct
    // from `gyms/{gymId}/private/qr_token` (a rotating check-in secret for
    // people who already have the app). A 'gym' code must carry `gym_id`,
    // and the creator must be THAT gym's real owner — just matching
    // owner_uid to yourself (the pre-existing check, still here) would let
    // anyone stamp any gym_id on their own code. `campaign`/`location_note`
    // are free text, capped like every other user-authored note in this
    // file. `gym_id`/`type`/`owner_uid` are pinned immutable on update — a
    // code can't be relabeled into a different owner's gym after creation.
    // `printed_at`, when touched, must be the server timestamp (mirrors
    // gyms/{gymId}/members' `last_check_in` — not a client-supplied backdate).
    match /referrals/{code} {
      // Any authenticated user may read a referral doc (to validate a code).
      allow read: if isAuthenticated();
      // Only the owner may create their own referral doc.
      allow create: if isAuthenticated()
        && request.resource.data.owner_uid == request.auth.uid
        && request.resource.data.get('type', 'user') in ['user', 'coach_vanity', 'gym']
        && (request.resource.data.get('type', 'user') != 'gym'
            || (request.resource.data.gym_id is string
                && get(/databases/$(database)/documents/gyms/$(request.resource.data.gym_id)).data.owner_uid == request.auth.uid))
        && request.resource.data.get('campaign', '').size() <= 80
        && request.resource.data.get('location_note', '').size() <= 200;
      // The applying user is added to used_by_uids ONLY by the applyReferral
      // Cloud Function (Admin SDK, bypasses rules), and rewards are server-
      // granted. A client may update a code doc only if it OWNS the code (coach
      // vanity / settings / gym panel) or is admin, and may never change
      // owner_uid, type, or gym_id — so a non-owner can no longer rewrite usage
      // or self-grant (audit C8), and an owner can't repoint their own code at
      // a gym they don't own after the fact.
      allow update: if isAuthenticated()
        && (resource.data.owner_uid == request.auth.uid || isAdmin())
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.get('type', 'user') == resource.data.get('type', 'user')
        && request.resource.data.get('gym_id', null) == resource.data.get('gym_id', null)
        && request.resource.data.get('campaign', '').size() <= 80
        && request.resource.data.get('location_note', '').size() <= 200
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['printed_at'])
            || request.resource.data.printed_at == request.time);
      allow delete: if false;
    }

    // ─── Gym attribution (Faz 6 §6.5) ──────────────────────────────────────
    // Server-written, immutable — created only by applyReferral's `type ==
    // 'gym'` branch (Admin SDK, bypasses this rule entirely) the moment a
    // gym-issued invite code is redeemed, and later touched only by
    // maybeAwardGymCommission (functions/economy.js, also Admin SDK) to stamp
    // first_premium_at and accrue lifetime_commission_try. No client create/
    // update/delete path exists, for either the attributed user or the gym.
    //
    // Read is owner-only (the attributed user themselves) — deliberately NOT
    // additionally readable by the gym's owner, unlike e.g. gyms/{id}/presence
    // or member_summaries above (which DO allow the gym owner to read a
    // member's doc directly). §6.5's own requirement is that individual user
    // identity never reaches the gym; the gym-facing funnel report instead
    // reads the AGGREGATE attributed_member_count/attributed_premium_count
    // counters on its own gyms/{gymId} doc (protected by
    // touchesProtectedGymFields() above), never this collection. The
    // attributed user's own "disconnect" (hide the "you signed up via
    // {gym}" banner on their profile) is a DISPLAY-only preference stored
    // separately at users/{uid}/private/attribution_prefs (already covered
    // by the existing wildcard `match /private/{docId}` owner-only rule
    // above) — this doc itself stays immutable either way, since the gym's
    // already-earned/earning commission must not be erasable by the user
    // who generated it.
    match /gym_attributions/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    // ─── Community Groups ─────────────────────────────────────────────────────
    match /community_groups/{groupId} {
      // Any authenticated user can read groups (discovery). NOTE: this does
      // NOT filter by is_public/kind=='private' — a private group's
      // metadata is readable if you know/guess its id. Pre-existing gap
      // (docs/roadmap/COMMUNITY_GROUPS.md §7 already flags discovery
      // privacy as a client query-side convention, not a rules guarantee),
      // unchanged by Faz 2 §2.3. What IS newly guarded is the invite
      // code — see `secrets/invite` below and the top-level
      // `group_invites/{code}` block — neither is reachable via this rule.
      allow read: if isAuthenticated();
      // Creator must own the group — OR an admin creating it on someone
      // else's behalf (Faz 2 §2.3: AdminService.approveGymApplication
      // batch-creates a kind:'gym' group owned by the GYM OWNER, not the
      // approving admin — an owner_uid-only check would reject that batch
      // outright, since the batch is written under the ADMIN's auth
      // context). kind/join_policy are validated against the schema's enum
      // values when present; absent defaults to 'public'/'open' so every
      // pre-Faz-2.3 create call site (which never sends these fields) keeps
      // working unchanged.
      // SEC-12: rate-limited (functions/ugc_rate_limit.js) — groups are
      // created rarely in genuine use, so this is a pure anti-flood
      // backstop, not a real constraint on any real workflow.
      allow create: if isAuthenticated()
        && (request.resource.data.owner_uid == request.auth.uid || isAdmin())
        && request.resource.data.get('kind', 'public') in ['public', 'private', 'gym']
        && request.resource.data.get('join_policy', 'open') in ['open', 'request', 'invite']
        && !isGroupCreateRateLimited();
      // Owner/admin can edit freely; any member may bump only the counter
      // fields (member_count / last_activity_at) on join/leave/post, and
      // member_count only by ±1 per write (canUpdateGroupCounters). A
      // group-level 'admin' role does NOT get this — announcement_only/
      // rules_text/pinned_message_id edits stay owner/site-admin-only (see
      // CommunityGroupService.updateGroupSettings's doc comment). Faz 2
      // §2.5: the owner branch additionally excludes activity_score/
      // activity_updated_at (touchesProtectedGroupFields) — server-only,
      // see that function's comment above.
      allow update: if isAuthenticated()
        && ((resource.data.owner_uid == request.auth.uid && !touchesProtectedGroupFields())
            || isAdmin()
            || canUpdateGroupCounters());
      allow delete: if isAuthenticated()
        && (resource.data.owner_uid == request.auth.uid || isAdmin());

      // Members subcollection: a user manages their own membership doc, but
      // may only ever self-assign role 'member' — UNLESS they are the
      // group's real owner_uid. (createGroup creates the parent doc first,
      // awaited, THEN the owner's own 'owner' membership doc in a second
      // write — deliberately not one batch, so this get() always reads an
      // already-committed parent rather than depending on same-batch write
      // visibility.) 'moderator'/'admin' can only be granted by the
      // owner/admin branch below, never by self-write (closes a
      // privilege-escalation hole: previously any authenticated user could
      // self-write role: 'owner' on their own membership doc in ANY group).
      //
      // Faz 2 §2.3: self-join as 'member' additionally requires
      // join_policy == 'open' — 'request'/'invite' groups route through
      // join_requests/{uid} (owner/admin approval writes this doc) or a
      // redeemed invite code (functions/groups.js, Admin SDK) instead, never
      // a direct self-write. A group owner/group-admin adding someone ELSE
      // may not hand them role 'owner' here — that would create a second
      // "owner" member disconnected from the group's actual owner_uid;
      // ownership transfer isn't a feature this rule supports. Site
      // isAdmin() is exempt from that restriction: AdminService.
      // approveGymApplication batch-creates the GYM OWNER's (not the
      // approving admin's own) 'owner' membership doc on their brand-new
      // gym group — a legitimate same-batch bootstrap, not a rogue
      // ownership grant.
      match /members/{memberId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
          && request.resource.data.role in ['owner', 'admin', 'moderator', 'member']
          && ((request.auth.uid == memberId
                && ((request.resource.data.role == 'member'
                      && get(/databases/$(database)/documents/community_groups/$(groupId)).data.get('join_policy', 'open') == 'open')
                    || (request.resource.data.role == 'owner'
                        && get(/databases/$(database)/documents/community_groups/$(groupId)).data.owner_uid == request.auth.uid)))
              || isAdmin()
              || (request.resource.data.role != 'owner'
                  && (get(/databases/$(database)/documents/community_groups/$(groupId)).data.owner_uid == request.auth.uid
                      || isGroupAdminRole(groupId))));

        // Role changes (structural — who is owner/admin/moderator) stay
        // owner/site-admin-only. A group-level 'admin' may ONLY touch
        // muted_until/banned (mute/ban moderation actions) — day-to-day
        // moderation shouldn't need the owner personally, but
        // promoting/demoting itself does.
        //
        // Faz 2 §2.6: a mute/ban write (touching muted_until/banned) is
        // additionally denied while the ACTING owner/admin is
        // isModerationRateLimited() — isAdmin() (site admin) stays exempt,
        // same asymmetry as touchesProtectedGroupFields()/
        // touchesProtectedGymFields() elsewhere in this file. Role changes
        // and any other owner-only field edit are UNAFFECTED by the lock —
        // it only ever gates the two moderation-consequence fields.
        allow update: if isAuthenticated()
          && (isAdmin()
              || (get(/databases/$(database)/documents/community_groups/$(groupId)).data.owner_uid == request.auth.uid
                  && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['muted_until', 'banned'])
                      || !isModerationRateLimited()))
              || (isGroupAdminRole(groupId)
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['muted_until', 'banned'])
                  && !isModerationRateLimited()));

        // Faz 2 §2.6: self-leave (memberId == caller) and isAdmin() are
        // exempt from the lock below — only an owner/group-admin KICKING
        // SOMEONE ELSE is gated by isModerationRateLimited().
        allow delete: if isAuthenticated()
          && (request.auth.uid == memberId
              || isAdmin()
              || ((get(/databases/$(database)/documents/community_groups/$(groupId)).data.owner_uid == request.auth.uid
                    || isGroupAdminRole(groupId))
                  && !isModerationRateLimited()));
      }

      // Join requests (join_policy == 'request'). Doc id == requester's uid
      // (idempotent re-request). Approving/declining never itself grants
      // membership — CommunityGroupService.approveJoinRequest does that as
      // a SEPARATE members/{uid} create in the same client batch.
      match /join_requests/{uid} {
        allow read: if isAuthenticated()
          && (request.auth.uid == uid
              || get(/databases/$(database)/documents/community_groups/$(groupId)).data.owner_uid == request.auth.uid
              || isGroupAdminRole(groupId)
              || isAdmin());
        allow create: if isAuthenticated()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && get(/databases/$(database)/documents/community_groups/$(groupId)).data.get('join_policy', 'open') == 'request';
        // Only status/responded_at/responded_by may change in practice, and
        // only owner/admin may change them — a requester can't self-approve
        // (uid is pinned so the request can't be reassigned to someone else
        // either).
        allow update: if isAuthenticated()
          && (get(/databases/$(database)/documents/community_groups/$(groupId)).data.owner_uid == request.auth.uid
              || isGroupAdminRole(groupId)
              || isAdmin())
          && request.resource.data.uid == resource.data.uid;
        allow delete: if isAuthenticated()
          && (request.auth.uid == uid
              || get(/databases/$(database)/documents/community_groups/$(groupId)).data.owner_uid == request.auth.uid
              || isGroupAdminRole(groupId)
              || isAdmin());
      }

      // Moderation log — mute/kick/ban/unmute/unban + reason + duration.
      // Immutable once written (mirrors admin_audit's shape). The target
      // uid may read entries about themselves (transparency: why was I
      // muted); nobody but owner/admin reads the full log.
      match /moderation/{autoId} {
        allow read: if isAuthenticated()
          && (resource.data.target_uid == request.auth.uid
              || get(/databases/$(database)/documents/community_groups/$(groupId)).data.owner_uid == request.auth.uid
              || isGroupAdminRole(groupId)
              || isAdmin());
        // Faz 2 §2.6: gated by !isModerationRateLimited() for the owner/
        // group-admin branch — isAdmin() stays exempt. This is the ONE
        // create rule every mute/kick/ban/unmute/unban action's batch
        // write must pass (CommunityGroupService's methods always pair the
        // members/{uid} mutation with a moderation/{autoId} log entry in
        // the same batch), so gating it here alone would already be
        // sufficient — the members/{memberId} update/delete rules above are
        // gated too as well, defense-in-depth, matching this file's existing
        // belt-and-suspenders style (e.g. canUpdateGroupCounters +
        // touchesProtectedGroupFields both guarding community_groups).
        allow create: if isAuthenticated()
          && request.resource.data.issued_by == request.auth.uid
          && request.resource.data.action in ['mute', 'kick', 'ban', 'unmute', 'unban']
          && (isAdmin()
              || ((get(/databases/$(database)/documents/community_groups/$(groupId)).data.owner_uid == request.auth.uid
                    || isGroupAdminRole(groupId))
                  && !isModerationRateLimited()));
        allow update, delete: if false;
      }

      // The group's own message stream ("akış + sohbet", Faz 2 §2.3) lives
      // at `chats/{chat_id}/messages` — see this doc's `chat_id` field and
      // the `chats/{chatId}` rules block's `isGroupBackedChat`/
      // `canAccessGroupChat` for the actual read/write rules. Deliberately
      // NOT a subcollection here: `lastMessage`/`updatedAt`/`unreadCounts`
      // chat-list rendering (chat_list_screen.dart's `_buildGymChatCard`,
      // already shipped and dormant) and the entire message send/paginate/
      // react/edit pipeline (ChatService, Faz 2 §2.1/§2.2) already exist for
      // `chats/{chatId}` — duplicating that under community_groups would be
      // exactly the "reinvent instead of reuse" this task was told to avoid.

      // Invite-code secret (Faz 2 §2.3). Deliberately NOT a field on the
      // parent doc above (readable by any authenticated user) — the same
      // class of bug as the gym QR token / user PII fixes elsewhere in this
      // file: a rule can't hide one field of an otherwise-readable doc, so
      // a redeemable secret can't live there. `invite_enabled` (a non-secret
      // boolean — "is joining by code currently possible") stays on the
      // parent doc; the actual code string lives only here. Owner/admin
      // only, both read (to display/copy/print) and write (regenerate).
      match /secrets/{docId} {
        allow read, write: if isAuthenticated()
          && (get(/databases/$(database)/documents/community_groups/$(groupId)).data.owner_uid == request.auth.uid
              || isGroupAdminRole(groupId)
              || isAdmin());
      }

      // Faz 5 §5.2 — per-member weekly contribution score (messages/posts/
      // comments within this group, weighted the same as
      // `computeGroupActivityScores`'s message/post/comment weights but as a
      // flat weekly sum, not a decaying "hot right now" score). Fully
      // server-only — bumped by `engagement_credit.js`'s onCreate triggers,
      // read by that file's `awardWeeklyGroupTop3` scheduled sweep. No
      // client (not even the group owner) reads this raw counter directly;
      // a future leaderboard UI (§5.3) would read a denormalized public
      // summary, never this.
      match /weekly_contributions/{weekKey}/members/{uid} {
        allow read, write: if false;
      }

      // Faz 5 §5.3 — the denormalized public summary promised by the
      // comment directly above: top-10 entries for the CURRENT week
      // (`{uid, display_name, photo_url, score, rank}`), recomputed every
      // 15 min by `computeGroupContributionLeaderboards`
      // (functions/engagement_credit.js). Read-only, and scoped to this
      // group's OWN members — not any authenticated user like
      // `community_groups/{groupId}` discovery reads above — because unlike
      // XP (already a public field on `users/{uid}`, see
      // `community_weekly_xp` below), a group's internal contribution
      // activity is not otherwise public information. Still fully
      // server-only to write, even for the group's own owner.
      match /weekly_leaderboard/{weekKey} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }
    }

    // ─── Group invite codes (reverse lookup: code → group_id) ────────────────
    // Faz 2 §2.3. Doc id IS the code (mirrors referrals/{code} — O(1)
    // doc-id lookup, no query, no index). Fully closed to reads: redemption
    // is a callable (functions/groups.js: redeemGroupInvite, Admin SDK,
    // bypasses this entirely) that validates is_active + invite_enabled +
    // existing membership/ban state server-side and returns a preview in
    // its RESPONSE — unlike referrals/{code} (which IS previewed via a
    // direct client read before applying), a client never inspects this doc
    // directly, so there's no legitimate read path. Owner/admin of the
    // group NAMED IN THE DOC may create/deactivate their own group's code
    // from the client — generation is low-risk; redemption (which actually
    // grants membership) is what must be server-validated.
    match /group_invites/{code} {
      allow read: if false;
      allow create: if isAuthenticated()
        && (get(/databases/$(database)/documents/community_groups/$(request.resource.data.group_id)).data.owner_uid == request.auth.uid
            || isGroupAdminRole(request.resource.data.group_id));
      allow update: if isAuthenticated()
        && request.resource.data.group_id == resource.data.group_id
        && (get(/databases/$(database)/documents/community_groups/$(resource.data.group_id)).data.owner_uid == request.auth.uid
            || isGroupAdminRole(resource.data.group_id));
      allow delete: if false;
    }

    match /gyms/{gymId} {
      // Any authenticated user can read gym profiles (for search/discovery)
      allow read: if isAuthenticated();
      // Only the gym owner can create/update their gym
      allow create: if isAuthenticated()
        && request.resource.data.owner_uid == request.auth.uid;
      // Owner updates gym; admin may set is_verified badge; any authenticated
      // user may bump member_count by ±1 (join/leave — canUpdateGymMemberCount).
      // Owner is denied touching live_occupancy directly (touchesProtectedGymFields) —
      // that counter is server-maintained only (Faz 1.5).
      allow update: if isAuthenticated()
        && ((resource.data.owner_uid == request.auth.uid && !touchesProtectedGymFields())
            || isAdmin()
            || canUpdateGymMemberCount());
      allow delete: if isAuthenticated()
        && resource.data.owner_uid == request.auth.uid;

      // Gym members subcollection. Previously write required gym-owner-or-
      // admin, which meant a member could never write their OWN membership
      // doc — joinGym/leaveGym/_recordCheckIn all failed outright (audit:
      // the entire gym ecosystem was unreachable past this rule). Now a
      // member may self-create (standard tier only — no client-side
      // escalation to premium), self-delete (leave), and self-update ONLY
      // their own `last_check_in` as a server timestamp (records a
      // check-in). Owner/admin retain full control (tier changes, forced
      // removal, admin backfill).
      match /members/{memberId} {
        // Faz 5 §5.3: `|| isGymMember(gymId)` is the fix — see that
        // function's doc comment above for why this was a real, pre-
        // existing gap (the in-gym leaderboard's own member-list query was
        // silently denied for every non-owner member until now).
        allow read: if isAuthenticated()
          && (get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_uid == request.auth.uid
              || request.auth.uid == memberId
              || isGymMember(gymId));

        allow create: if isAuthenticated()
          && ((request.auth.uid == memberId && request.resource.data.tier == 'standard')
              || get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_uid == request.auth.uid
              || isAdmin());

        allow update: if isAuthenticated()
          && ((request.auth.uid == memberId
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['last_check_in'])
                && request.resource.data.last_check_in == request.time)
              || get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_uid == request.auth.uid
              || isAdmin());

        allow delete: if isAuthenticated()
          && (request.auth.uid == memberId
              || get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_uid == request.auth.uid
              || isAdmin());
      }

      // Gym community posts
      match /posts/{postId} {
        // Any authenticated user can read posts
        allow read: if isAuthenticated();
        // SEC-07 fix: this used to say "membership enforced app-side," but
        // GymPostService.createPost() (lib/core/services/gym_post_service.dart)
        // performs no membership check at all — at most a UI-level
        // affordance, trivially bypassed by any direct write. Also had no
        // content-length cap at all (contrast the top-level posts/{postId}
        // rule's 5000-char cap). isGymMember() mirrors this file's own
        // existing helper (used for the gym leaderboard read gate) rather
        // than inventing new logic. SEC-12: rate-limited (shared 'post'
        // budget with the top-level posts rule above).
        allow create: if isAuthenticated()
          && request.resource.data.author_uid == request.auth.uid
          && isGymMember(gymId)
          && request.resource.data.get('content', '').size() <= 5000
          && !isPostRateLimited();
        // Author can update their own post content; owner can update any field;
        // any authenticated user can update like/comment counters only (BLK-08:
        // was a denylist that let anyone flip is_announcement/is_pinned too).
        allow update: if isAuthenticated()
          && (resource.data.author_uid == request.auth.uid
            || get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_uid == request.auth.uid
            || canUpdateGymPostEngagement());
        allow delete: if isAuthenticated()
          && (resource.data.author_uid == request.auth.uid
            || get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_uid == request.auth.uid);

        // Post comments
        match /comments/{commentId} {
          allow read: if isAuthenticated();
          // SEC-07/SEC-12: same fix as the parent posts rule above — was
          // missing membership + a length cap entirely; now rate-limited
          // (shared 'comment' budget with the top-level comments rule).
          allow create: if isAuthenticated()
            && request.resource.data.author_uid == request.auth.uid
            && isGymMember(gymId)
            && request.resource.data.get('content', '').size() <= 2000
            && !isCommentRateLimited();
          allow update: if isAuthenticated()
            && resource.data.author_uid == request.auth.uid;
          allow delete: if isAuthenticated()
            && (resource.data.author_uid == request.auth.uid
              || get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_uid == request.auth.uid);
        }
      }

      // Owner-only QR check-in token (Faz 0 §0.7). Previously the token
      // lived directly on the public gyms/{gymId} doc (`qr_token`/
      // `qr_token_expires_at`) — any authenticated user could read it with
      // a plain get(), defeating "you must physically scan the printed QR
      // code" entirely. It now lives here (doc id `qr_token`), readable
      // only by the gym's own owner/admin — they render it as an image via
      // qr_flutter; members never read this path directly, they obtain the
      // token exclusively by scanning that image. validateGymCheckin
      // (Cloud Function, Admin SDK) is the only thing that ever compares a
      // scanned token against the stored value and writes the resulting
      // check-in — see functions/gym.js.
      match /private/{docId} {
        allow read, write: if isAuthenticated()
          && (get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_uid == request.auth.uid
              || isAdmin());
      }

      // Check-in records. `timestamp == request.time` requires the client
      // write a serverTimestamp() sentinel (GymService._recordCheckIn does)
      // rather than a spoofable client clock value; `method` is restricted
      // to the values CheckInMethod actually produces client-side. The
      // 'qr' method is now written only by validateGymCheckin (Admin SDK,
      // bypasses this rule) — this create rule still gates the 'gps'/
      // 'manual' paths, which remain direct client writes (Faz 1.5).
      // SEC-08 fix: this create rule only ever checked uid/timestamp/method
      // shape — no membership check at all, and for 'gps'/'manual' no
      // server-side proximity check either (the client computed Haversine
      // itself and self-reported "close enough"). Both real client
      // check-in paths (QR, GPS) now go through validateGymCheckin/
      // validateGymGpsCheckin (functions/gym.js) — membership + (for GPS)
      // distance recompute server-side, Admin SDK is the only writer.
      // 'manual' had no client entry point already (Faz 0 §0.7); a future
      // front-desk flow would need its own callable too, not a rules
      // exemption.
      match /checkins/{checkinId} {
        allow read: if isAuthenticated()
          && (get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_uid == request.auth.uid
              || request.auth.uid == resource.data.uid);
        allow create, update, delete: if false;
      }

      // Faz 1 §1.4: live gym-presence doc, doc id == the member's own uid.
      // Only exists while the member is inside (recordPresenceEvent creates
      // it on enter, deletes it on exit/timeout — Faz 1.5). No raw lat/lng
      // ever — entered_at/source/last_seen_at/expires_at/denormalized
      // display_name+photo_url only. Client never writes this directly:
      // the whole point of Faz 1.5 is server-side geofence/membership/
      // consent/rate-limit validation before a presence doc can exist.
      match /presence/{uid} {
        allow read: if isAuthenticated()
          && (get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_uid == request.auth.uid
              || request.auth.uid == uid);
        allow write: if false;
      }

      // Closed, immutable presence session (Faz 1.4) — written once by
      // recordPresenceEvent on exit/timeout, never touched again. Same
      // read audience as the live doc above; doc id is an autoId (not the
      // uid), so the self-read check is against resource.data.uid instead.
      match /presence_sessions/{autoId} {
        allow read: if isAuthenticated()
          && (get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_uid == request.auth.uid
              || request.auth.uid == resource.data.uid);
        allow create, update, delete: if false;
      }

      // Faz 1 §1.7: dedup log for the "friend at gym" notification fan-out
      // (onGymPresenceCreated) — purely internal bookkeeping, nobody (not
      // even the gym owner) has a legitimate reason to read or write it
      // from a client. Same fully-server-only shape as processed_purchases.
      match /presence_notify_log/{logId} {
        allow read, write: if false;
      }

      // Faz 4 §4.2 — server-generated, tier-gated progress summary cache.
      // Client NEVER writes this (only generateMemberProgressSummary, Admin
      // SDK) — the callable is the only place progress_sharing's tier is
      // ever consulted, so a client can't forge a summary or bypass tier 0.
      // Read audience mirrors presence/checkins above: the gym owner sees
      // any of their members' summaries; the member sees their own (same
      // transparency stance as access_log below). expires_at (7-day TTL) is
      // swept by expireMemberProgressSummaries (functions/summaries.js); a
      // tier change or revoke deletes it immediately via
      // onProgressSharingWrite instead of waiting for that sweep.
      match /member_summaries/{uid} {
        allow read: if isAuthenticated()
          && (get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_uid == request.auth.uid
              || request.auth.uid == uid);
        allow write: if false;
      }

      // Faz 4 §4.3 — dedup receipt for the tier-0 "send a progress-sharing
      // invite" button (sendProgressShareInvite, functions/summaries.js).
      // The doc EXISTING is the "already invited, ever" state — the
      // callable creates it with .create() (fails if present), so this can
      // only ever fire once per (gym, member) pair. Read-only for the gym
      // owner (so the UI can render "already invited" without a second
      // callable round-trip); nobody — not even the owner — writes it
      // directly, only the callable does after re-deriving the same
      // gym-ownership authority generateMemberProgressSummary requires.
      match /progress_share_invites/{memberUid} {
        allow read: if isAuthenticated()
          && get(/databases/$(database)/documents/gyms/$(gymId)).data.owner_uid == request.auth.uid;
        allow write: if false;
      }
    }

    // ─── Gym Wars ─────────────────────────────────────────────────────────────
    match /gym_wars/{warId} {
      // Any authenticated user can read wars (for discovery)
      allow read: if isAuthenticated();
      // Only the challenger (gym owner) can create a war
      allow create: if isAuthenticated()
        && request.resource.data.challenger_uid == request.auth.uid;
      // Only the challenger can update (e.g. end the war)
      allow update: if isAuthenticated()
        && resource.data.challenger_uid == request.auth.uid;
      allow delete: if false;
    }

    // ─── Coach Profiles ───────────────────────────────────────────────────────
    match /coach_profiles/{coachUid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(coachUid);
      // Owner updates their own profile; admin may set is_verified badge.
      allow update: if isOwner(coachUid) || isAdmin();
      allow delete: if false;

      match /clients/{clientUid} {
        // Coach reads all clients; client reads own entry
        allow read: if isAuthenticated()
          && (request.auth.uid == coachUid || request.auth.uid == clientUid);
        // Client creates request for themselves; coach updates status
        allow create: if isAuthenticated() && request.auth.uid == clientUid;
        allow update: if isAuthenticated()
          && (request.auth.uid == coachUid || request.auth.uid == clientUid);
        allow delete: if false;
      }

      // Faz 4 §4.2 — coach-scope equivalent of gyms/{gymId}/member_summaries
      // above; same server-only write, same "owner or the member
      // themselves" read audience.
      match /member_summaries/{uid} {
        allow read: if isAuthenticated()
          && (request.auth.uid == coachUid || request.auth.uid == uid);
        allow write: if false;
      }

      // Faz 4 §4.3 — coach-scope equivalent of gyms/{gymId}/progress_share_invites
      // above; same one-time-ever dedup receipt, same server-only write.
      match /progress_share_invites/{memberUid} {
        allow read: if isAuthenticated() && request.auth.uid == coachUid;
        allow write: if false;
      }
    }

    // ─── Programs (marketplace) ───────────────────────────────────────────────
    match /programs/{programId} {
      // Any authenticated user can browse published programs
      allow read: if isAuthenticated();
      // BLK-09 fix: coach_uid == 'demo' used to be a client-writable bypass
      // ("reserved for the DemoContentSeeder") — but a rule can never tell
      // "the real seeder" apart from "an attacker copying the same write";
      // both are ordinary authenticated writes with an identical shape, and
      // every OTHER field (title, description, coach_name: 'Cookrange
      // Team', ...) was fully attacker-controlled. Demo content is now
      // seeded server-side only, via the seedDemoContent callable
      // (functions/demo_content.js, Admin SDK) — a coach can only ever
      // create a program under their OWN uid.
      allow create: if isAuthenticated()
        && request.resource.data.coach_uid == request.auth.uid;
      // Owning coach can update/delete; admin can update status (approve/reject).
      allow update: if isAuthenticated()
        && (resource.data.coach_uid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated()
        && resource.data.coach_uid == request.auth.uid;

      // Week content subcollection — any enrolled user or owner may read.
      // Writes restricted to the owning coach — see the BLK-09 fix above;
      // the same reasoning applies here (demo week content is seeded
      // server-side by the same callable, never client-direct).
      match /weeks/{weekId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated()
          && get(/databases/$(database)/documents/programs/$(programId)).data.coach_uid == request.auth.uid;
      }
    }

    // ─── Meal plan templates (Faz 3 §3.2) ──────────────────────────────────────
    // Reusable weekly plans authored by a gym/coach/admin, independent of any
    // one member's meal_plans/current. Sent to a member as an immutable copy
    // via users/{uid}/plan_offers/{id} below — editing/deleting a template
    // never touches an already-sent offer.
    //
    // Read visibility is share_scope-gated (author/admin always; is_public
    // to everyone; 'gym' to that gym's own members via the same
    // exists()-on-the-members-subcollection check gyms/{id}/members already
    // uses elsewhere in this file). 'link'/'marketplace' are accepted as
    // valid share_scope values but have no distinct read mechanism of their
    // own yet — that likely needs a secret-token pattern (mirroring
    // community_groups/secrets/invite), a decision left to whoever builds
    // §3.3/§3.5's sharing UI, not made here. Write always stays author-only
    // (mirrors community_groups' owner-write pattern) — isAdmin() is an
    // additional override, consistent with every other collection in this
    // file, not a loosening the plan asked for: no OTHER gym/coach can ever
    // write a template they don't own.
    match /meal_plan_templates/{templateId} {
      allow read: if isAuthenticated()
        && (resource.data.author_uid == request.auth.uid
            || isAdmin()
            || resource.data.get('is_public', false) == true
            || (resource.data.get('share_scope', 'private') == 'gym'
                && resource.data.gym_id != null
                && exists(/databases/$(database)/documents/gyms/$(resource.data.gym_id)/members/$(request.auth.uid))));

      allow create: if isAuthenticated()
        && request.resource.data.author_uid == request.auth.uid
        && request.resource.data.author_type in ['gym', 'coach', 'admin']
        && request.resource.data.get('share_scope', 'private') in ['private', 'gym', 'link', 'marketplace']
        // A brand-new template has never been sent — usage_count starts at
        // 0 (or absent); only sendPlanOffer ever increments it afterward.
        && request.resource.data.get('usage_count', 0) == 0
        && request.resource.data.get('name', '').size() <= 200
        && request.resource.data.get('description', '').size() <= 2000;

      allow update: if isAuthenticated()
        && ((resource.data.author_uid == request.auth.uid
              && !touchesProtectedTemplateFields()
              && request.resource.data.get('name', '').size() <= 200
              && request.resource.data.get('description', '').size() <= 2000)
            || isAdmin());

      allow delete: if isAuthenticated()
        && (resource.data.author_uid == request.auth.uid || isAdmin());
    }

    // ─── Seeds (idempotent seeder gates) ──────────────────────────────────────
    // Used by client-side seeders (DemoContentSeeder, etc.) to record completed
    // seed runs. Any authenticated user may read or write — the seeder checks the
    // flag before writing, so this is safe to leave open to authenticated clients.
    // BLK-09 fix: `seeds/demo` used to be client-writable (the old
    // DemoContentSeeder set its own completion marker directly) — now
    // written only by the seedDemoContent callable (Admin SDK). No client
    // needs to read it either: the callable is unconditionally invoked on
    // every app start and decides internally whether there's anything left
    // to seed, exactly like app_config's admin-write lockdown elsewhere in
    // this file.
    match /seeds/{docId} {
      allow read, write: if false;
    }

    // Program enrollments: owner-only
    match /users/{uid}/program_enrollments/{programId} {
      allow read, write: if isOwner(uid);
    }

    // ─── Commission earnings (per-user subcollection) ─────────────────────────
    match /users/{uid}/commissions/{commissionId} {
      // Owner reads their own commissions. Writes are SERVER-ONLY — commissions
      // are recorded by Cloud Functions after validation, never by clients
      // (closes forgeable-earnings → payout fraud, audit C8).
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // ─── Coaching requests (client→coach) ────────────────────────────────────
    // Path: users/{coachUid}/coaching_requests/{clientUid}
    // Coach reads their own requests; client reads/writes their own request doc.
    match /users/{uid}/coaching_requests/{requestDoc} {
      allow read: if isAuthenticated()
        && (request.auth.uid == uid || request.auth.uid == requestDoc);
      allow write: if isAuthenticated() && request.auth.uid == requestDoc;
    }

    // ─── Payout requests ──────────────────────────────────────────────────────
    match /users/{uid}/payout_requests/{requestId} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // ─── AI twin projections (history) ────────────────────────────────────────
    match /users/{uid}/ai_twin_projections/{doc} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // ─── AI weekly recaps (owner-only) ────────────────────────────────────────
    match /users/{uid}/ai_weekly_recaps/{doc} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // ─── Achievements / badges ─────────────────────────────────────────────────
    // Faz 0 §0.4: previously owner-writable — any authenticated user could
    // self-grant any badge (e.g. write users/{own uid}/achievements/streak100
    // directly, no streak required). Granted only by the syncProgress /
    // backfillProgress Cloud Functions (functions/progress.js) now.
    match /users/{uid}/achievements/{achievementKey} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // ─── XP ledger (Faz 5 §5.1) ────────────────────────────────────────────
    // Immutable, server-only — `awardXp` (functions/progress.js) is the only
    // writer, and `eventId` (its own doc id, `${kind}_${refId}`) is what
    // makes every award idempotent AND is how a daily cap gets enforced
    // (count today's docs of a `kind`, reject once at the cap) — a client
    // write here, in either direction, would defeat both. Owner-only read,
    // same privacy level as `achievements/*` above (a fine-grained activity
    // timeline is more sensitive than the aggregate `xp`/`level` numbers on
    // the root profile doc, which stay visible to any authenticated user
    // exactly like `reputation_score` already was).
    match /users/{uid}/xp_events/{eventId} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // ─── Weekly community XP rollup (Faz 5 §5.3) ───────────────────────────
    // Denormalized per-(week, uid) XP-earned-THIS-WEEK counter, bumped
    // transactionally by `awardXp` (functions/progress.js) inside the SAME
    // transaction that awards XP for ANY kind — free (no extra read), since
    // that transaction already has the user's displayName/photoURL in hand
    // from its own userSnap read. Backs the weekly community leaderboard AND
    // (via a chunked whereIn lookup, never a rule change) the in-gym
    // leaderboard. Flat `allow read: if isAuthenticated()` — deliberately
    // NOT narrower — because `xp` itself is already a PUBLIC field on the
    // `users/{uid}` root doc (Faz 0 §0.2's field-allowlist), so a weekly
    // rollup of the same already-public number carries no additional
    // sensitivity. Contrast with `community_groups/{id}/weekly_leaderboard`
    // above, which IS member-scoped, because a group's contribution
    // activity is not otherwise public.
    match /community_weekly_xp/{weekKey}/members/{uid} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // ─── Received-engagement credit ledger (Faz 5 §5.2) ────────────────────
    // Immutable, server-only — `awardEngagementCredit` (functions/
    // engagement_credit.js) is the only writer. Mirrors `xp_events` exactly:
    // `eventId = ${source}_${refId}` is both the idempotency key and, via a
    // `source + created_at` composite index, how the daily/weekly cap is
    // enforced (count already-awarded events of this source since the
    // window start, reject the next one once at the cap). A real award ALSO
    // credits `ai_credits/{uid}.bonus` (`entitlements.js`'s existing
    // `grantBonusCredits`) — this ledger is the audit trail, not a second
    // spendable currency.
    match /users/{uid}/engagement_credit_events/{eventId} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // ─── Shadow-restriction state (Faz 5 §5.2) ──────────────────────────────
    // Mirrors `ai_credits`/`entitlements` exactly: owner-read (the affected
    // user needs to SEE they're restricted in order to appeal — this is not
    // meant to be secret from them, only from other users, who never read
    // this path at all), server/admin-write only. `is_shadow_restricted`
    // gates credit accumulation ONLY — it has no bearing on content
    // visibility (`posts`/`comments`/etc. rules are completely untouched by
    // this collection). `flag_count` is a rolling suspicion counter bumped
    // by `bumpSuspicionFlag`; crossing a threshold sets
    // `is_shadow_restricted` and `latest_entry_id` (the matching
    // `credit_moderation` log entry the appeal below references).
    match /credit_restrictions/{uid} {
      allow read: if isOwner(uid);
      allow write: if isAdmin();
    }

    // ─── Shadow-restriction moderation log (Faz 5 §5.2) ─────────────────────
    // Immutable restrict/lift history at ACCOUNT scope — the same shape as
    // `community_groups/{groupId}/moderation/{autoId}` above, just without a
    // group (this is never group-specific). Written by
    // `engagement_credit.js`'s `bumpSuspicionFlag` (Admin SDK, bypasses this
    // rule entirely) or, in the future, by an admin action — never by the
    // affected user themselves.
    match /users/{uid}/credit_moderation/{autoId} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthenticated() && isAdmin();
      allow update, delete: if false;
    }

    // ─── Reciprocity-ring + engagement-diversity signals (Faz 5 §5.2) ──────
    // Fully server-only bookkeeping — no client read or write path exists,
    // or should: these exist purely to inform `engagement_credit.js`'s
    // anti-abuse weighting (see that file + `engagement_credit_logic.js`).
    // Same "internal, nobody reads this back through the client SDK" shape
    // as `rate_limits`/`processed_purchases`/`presence_notify_log`
    // elsewhere in this file.
    match /reciprocity_pairs/{pairKey} {
      allow read, write: if false;
    }
    match /engagement_diversity/{uid} {
      allow read, write: if false;
    }

    // ─── Consent records (KVKK/GDPR — demonstrable, versioned, owner-only) ─────
    match /users/{uid}/consents/{purpose} {
      allow read, write: if isAuthenticated() && request.auth.uid == uid;
    }

    // ─── Progress-sharing consent (Faz 4 §4.1 — tiered, per-scope) ─────────────
    // Deliberately a DIFFERENT shape from consents/{purpose} above: not one
    // global purpose but one doc PER SCOPE (scopeId = 'gym_{gymId}' |
    // 'coach_{uid}') carrying a 0-3 TIER rather than a bool. Level 0
    // (default) shares nothing; the member grants/raises/revokes each scope
    // independently. Same audit philosophy as consents/{purpose} (server-
    // authoritative timestamp, policy_version stamped) but write stays
    // owner-direct (mirrors ConsentService.setConsent) since granting/
    // revoking IS the user's own action — generateMemberProgressSummary
    // (functions/summaries.js) re-derives real gym/coach authority itself
    // and never trusts this doc's mere existence as proof of a real
    // relationship. onProgressSharingWrite (same file) reacts to every
    // write here by deleting any cached gyms/{id}/member_summaries or
    // coach_profiles/{id}/member_summaries doc for this (uid, scopeId) pair
    // — a tier change invalidates a cached summary IMMEDIATELY rather than
    // waiting out its 7-day TTL, per docs/COMPLIANCE.md's "withdrawable as
    // easily as it was given" bar.
    match /users/{uid}/progress_sharing/{scopeId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.level is int
        && request.resource.data.level in [0, 1, 2, 3]
        && request.resource.data.policy_version is string
        && request.resource.data.policy_version.size() > 0
        && (request.resource.data.level == 0
              ? request.resource.data.revoked_at == request.time
              : (request.resource.data.granted_at == request.time
                  && request.resource.data.revoked_at == null));
      // No delete — revoking sets level:0 (keeps granted_at/revoked_at as a
      // history of the last grant/revoke instead of erasing it). Still
      // covered by deleteUserAccount's recursive erasure as an owner
      // subcollection.
      allow delete: if false;
    }

    // ─── Progress-summary access log (Faz 4 §4.2 — transparency) ──────────────
    // "Who generated a summary about me, and when" — written ONLY by
    // generateMemberProgressSummary (Admin SDK), never by a client.
    // Deliberately survives a later consent revocation — it's a record of
    // PAST access, not a live permission — onProgressSharingWrite never
    // touches this collection.
    match /users/{uid}/access_log/{entryId} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // ─── Coach applications ────────────────────────────────────────────────────
    // Applicant can read/write their own; admin can read/write all.
    match /coach_applications/{appId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.applicantUid || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.applicantUid == request.auth.uid;
      allow update: if isAuthenticated() && isAdmin();
    }

    // ─── Gym applications ──────────────────────────────────────────────────────
    match /gym_applications/{appId} {
      allow read: if isAuthenticated()
        && (request.auth.uid == resource.data.applicantUid || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.applicantUid == request.auth.uid;
      allow update: if isAuthenticated() && isAdmin();
    }

    // ─── Admin audit log (append-only, admin-read-only) ─────────────────────
    // Path: admin_audit/{id}
    // Written by admin actions (AdminService.logAuditAction). Only admins can
    // read; nobody can update or delete — this is an immutable audit trail.
    match /admin_audit/{id} {
      allow create: if isAuthenticated() && isAdmin();
      allow read: if isAuthenticated() && isAdmin();
      allow update, delete: if false;
    }

    // Faz A §A9 — `admin_config/{docId}` rule REMOVED. The collection was an
    // orphaned second config surface next to app_config/*: its only writer
    // (AdminService.updateAdminConfig) had zero callers (deleted alongside
    // this rule), and this rule's own comment — claiming
    // admin_status_service read maintenance_mode/min_version from here —
    // was stale; that service actually reads Firebase Remote Config, never
    // this collection. No matching rule now = denied by default, matching
    // this file's own "no catch-all" discipline elsewhere (see app_config/*
    // above). `settings/content_filter` (unaffected, unrelated rule further
    // up) is where the one real value this ever held —
    // `blocked_keywords` — now lives, written by the `updateContentFilter`
    // callable.

    // ─── Broadcasts (admin push + in-app announcements) ───────────────────────
    // Admins create and read; Cloud Functions update status/counts; nobody deletes.
    match /broadcasts/{id} {
      allow read: if isAuthenticated() && isAdmin();
      allow create: if isAuthenticated() && isAdmin()
        && request.resource.data.admin_uid == request.auth.uid;
      allow update: if isAuthenticated() && isAdmin();
      allow delete: if false;
    }

    // ─── Streak Squads ────────────────────────────────────────────────────────
    // Members can read their own squads; any authenticated user can create;
    // members can update; only the creator can delete.
    match /squads/{squadId} {
      allow read: if isAuthenticated()
        && request.auth.uid in resource.data.memberUids;
      allow create: if isAuthenticated()
        && request.auth.uid == request.resource.data.creatorUid
        && request.auth.uid in request.resource.data.memberUids;
      allow update: if isAuthenticated()
        && request.auth.uid in resource.data.memberUids;
      allow delete: if isAuthenticated()
        && request.auth.uid == resource.data.creatorUid;
    }

    // ─── Coach Reviews ────────────────────────────────────────────────────────
    // Path: coach_profiles/{coachUid}/reviews/{reviewerUid}
    // Linked clients create one review (doc id = reviewerUid, so Firestore's
    // own create-only-if-absent semantics already block a second review from
    // the same reviewer); all authenticated users read; reviews are immutable
    // once submitted (no update/delete).
    //
    // SEC-09 fix: this comment always said "linked clients create one
    // review," but nothing below actually checked the linkage — only
    // CoachReviewService.canReview() did, client-side (lib/core/services/
    // coach_review_service.dart), which a direct API/SDK write bypasses
    // entirely. The exists() check mirrors canReview()'s own bar exactly
    // (existence of coach_profiles/{coachUid}/clients/{reviewerUid}, no
    // status filter) — matching the app's own already-established
    // definition of "eligible to review" rather than inventing a stricter
    // one that would reject a review the client UI thought was allowed.
    match /coach_profiles/{coachUid}/reviews/{reviewerUid} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.auth.uid == reviewerUid
        && request.resource.data.reviewerUid == reviewerUid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && exists(/databases/$(database)/documents/coach_profiles/$(coachUid)/clients/$(reviewerUid));
      allow update, delete: if false;
    }

    // ─── Follow relationships ─────────────────────────────────────────────────
    // Following list: owner writes their own; any authenticated user reads.
    // SEC-12: create is rate-limited (functions/ugc_rate_limit.js) — delete
    // (unfollowing) is deliberately NOT limited, mirroring how every other
    // rate limit in this file gates content CREATION, never its removal.
    match /users/{uid}/following/{targetUid} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) && !isFollowRateLimited();
      allow delete: if isOwner(uid);
      allow update: if false;
    }

    // Followers list: any authenticated user creates/deletes their own entry.
    match /users/{uid}/followers/{sourceUid} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated() && request.auth.uid == sourceUid;
      allow update: if false;
    }

    // ─── AI credit ledger (server-authoritative) ─────────────────────────────
    // Written by Cloud Functions (aiProxy / purchase validation) via the Admin
    // SDK, or by an admin (panel comps; audited). Owner may READ for the credit
    // badge; regular users can never write (audit C1/C3).
    match /ai_credits/{uid} {
      allow read: if isOwner(uid);
      allow write: if isAdmin();
    }

    // ─── Entitlements (premium tier; server-authoritative) ────────────────────
    // Written by the purchase-validation / referral Cloud Functions, or by an
    // admin (comp premium; audited). Owner may READ; premium is never
    // client-grantable by regular users (audit C7).
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if isAdmin();
    }

    // ─── Processed purchase tokens (replay/dedupe guard; fully server-only) ───
    match /processed_purchases/{id} {
      allow read, write: if false;
    }

    // ─── Remote app config — Faz A §A2/§A5 audience-split + write lockdown ───
    // Each doc's read audience is the ONLY thing distinguishing it —
    // `critical` (kill-switches/maintenance/version/announcement/rollout) is
    // public so a logged-out client can still see maintenance mode and the
    // pre-auth onboarding fields (min age, referral-code TTL); `client` needs
    // auth because it also carries AI quota numbers; `server` (commission
    // rates, XP tables, anti-abuse thresholds, model pricing) is admin-only —
    // publishing THOSE would hand out a printed manual for evading every
    // anti-abuse threshold in the product (PLAN.md Faz A's own context §5).
    //
    // ALL THREE are write:false — no client, admin included, writes here
    // directly anymore. functions/app_config_admin.js's updateAppConfig
    // callable (Admin SDK, bypasses these rules entirely) is the only path
    // in: it validates every key against config_schema.json, enforces
    // cross-field invariants, rate-limits writes, and audits every change.
    // A blanket `allow write: if isAdmin()` — the OLD rule — accepted any
    // shape from any admin; with ~120 settings including money and
    // anti-abuse thresholds now living here, that is no longer defensible.
    //
    // No catch-all `match /app_config/{doc}` — Firestore grants a request if
    // ANY matching rule allows it, so a catch-all could never DENY anything;
    // its absence is what makes an unmatched/mistyped doc id (including the
    // legacy `global` below) deny-by-default rather than silently permissive.
    match /app_config/critical {
      allow read: if true;
      allow write: if false;
    }
    match /app_config/client {
      allow read: if isAuthenticated();
      allow write: if false;
    }
    match /app_config/server {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Remote app config — LEGACY doc, Faz A transition period ─────────────
    // `app_config/global` is the pre-migration doc — still the ACTIVE one
    // until Faz A §A8 Faz 3 seeds real data into critical/client/server
    // above. Read stays public (unchanged behavior for the current
    // production client). Write is ALSO locked to false, matching the three
    // docs above: the whole point of this phase is that nobody writes
    // app_config/* directly anymore, this doc included. See PLAN.md's own
    // note on deploy ordering — this doc's write lockdown and the new
    // callable's rollout must not leave a window with no admin path to
    // change config at all.
    match /app_config/global {
      allow read: if true;
      allow write: if false;
    }

    // ─── Config change history — Faz A §A6, immutable, admin-readable only ───
    // Written exclusively by updateAppConfig/rollbackAppConfig (Admin SDK).
    match /app_config_versions/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Admin roles (the real admin gate; server/console-written) ───────────
    // `admin_roles/{uid}.is_admin == true` grants admin. Owner may read own;
    // never client-writable (self-grant would be privilege escalation).
    match /admin_roles/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ─── Fine-grained admin permissions (DECISIONS.md ADR-024, M1.4) ─────────
    // Layers ON TOP of admin_roles above, does not replace it: admin_roles/
    // the `admin` custom claim it mirrors is still the coarse "is this account
    // an admin at all" gate every callable already checks. This doc answers
    // the narrower "which of cookrange-admin's screens/actions can THIS admin
    // reach" question — role + per-uid grants/denials, read by the web admin
    // panel's server-side requireAdmin() helper via the Admin SDK (which
    // bypasses these rules entirely). The rule below exists only to keep
    // every OTHER client (the Flutter app, a browser devtools session) from
    // reading or forging it directly — same console/Admin-SDK-only posture
    // as admin_roles, for the same reason (self-grant would be privilege
    // escalation).
    match /admin_users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if false;
    }

    // ─── AI usage logs (real token/cost per request) ─────────────────────────
    // Written ONLY by the aiProxy Cloud Function (Admin SDK). Admin-read for the
    // cost dashboard; clients can never read others' usage or forge cost/tokens.
    match /ai_usage_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── AI usage aggregates (global total, daily buckets, by-model/type) ─────
    // Server-written (aiProxy); admin-read only.
    match /ai_usage_stats/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Admin cross-domain daily rollup (Faz B M5.1) ────────────────────────
    // Server-written only: on-write increments from account.js's
    // deleteUserAccount / rate_limit.js's lockUntil throughout the day, plus
    // admin_stats.js's own scheduled aggregation pass once daily. Admin-read
    // only, same posture as ai_usage_stats above.
    match /admin_stats/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Notifications (canonical path; BLK-03/SEC-06) ───────────────────────
    // Fans out to push via the onInAppNotificationCreated trigger. Written only
    // by Cloud Functions (functions/notifications.js, social.js, economy.js,
    // index.js broadcast) — actorName/actorPhotoUrl are always re-fetched
    // server-side there, never trusted from a client payload. Owner may mark
    // read (update) and dismiss (delete) their own notifications directly.
    match /notifications/{uid}/items/{docId} {
      allow read: if isOwner(uid);
      allow create: if false;
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    // ─── Deny everything else ─────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
